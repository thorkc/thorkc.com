# ThorKC Asset Pipeline — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

# Storage provider (s3 | cloudflare | azure)
ASSET_STORAGE_PROVIDER=cloudflare

# Amazon S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ASSET_BUCKET=thorkc-assets

# Cloudflare R2
# ASSET_STORAGE_PROVIDER=cloudflare
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CF_ACCOUNT_ID=
# ASSET_BUCKET=thorkc-assets

# Azure Blob Storage
# ASSET_STORAGE_PROVIDER=azure
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_CONTAINER_NAME=thorkc-assets

# CDN
CDN_BASE_URL=https://pub-d8831bd212094ff6b05dc7155fb4867a.r2.dev

# CDN cache purge (cloudflare | fastly | bunny | none)
CDN_PURGE_PROVIDER=cloudflare
CF_ZONE_ID=
CF_API_TOKEN=

# Fastly purge
# FASTLY_API_KEY=
# FASTLY_SERVICE_ID=

# Bunny.net purge
# BUNNY_API_KEY=
